# ------------------------------------------------------------------------------
# Uttarakhand e-District AI Application Environment Configuration
# ------------------------------------------------------------------------------

# Database Configuration (PostgreSQL 16)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=uk_edistrict_db
DB_USER=edistrict_admin
DB_PASSWORD=edistrict_secure_pass_2026
DATABASE_URL=postgresql://edistrict_admin:edistrict_secure_pass_2026@postgres:5432/uk_edistrict_db

# Cache & Session Store (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass_2026
REDIS_URL=redis://:redis_secure_pass_2026@redis:6379/0

# Object Storage (MinIO / S3 for Document & Photo Uploads)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_pass_2026
MINIO_DEFAULT_BUCKETS=uk-citizen-documents,uk-applicant-photos
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secure_pass_2026
S3_REGION=ap-south-1

# Application Ports
PORT=8080
DEV_PORT=5173
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
